{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/gcal-cli",
  "title": "WireCat Google Calendar",
  "description": "Your Google Calendar for agents: sync, search and change events. Sign in with the gcal CLI first.",
  "websiteUrl": "https://wirecat.dev/en/docs/gcal",
  "repository": {
    "url": "https://github.com/WireCatLabs/gcal-cli",
    "source": "github"
  },
  "version": "0.10.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wirecat/gcal-cli",
      "version": "0.10.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all"
        }
      ]
    }
  ]
}
