#!/usr/bin/env bash
# The owner's first run against real Google: sign-in, calendars, two syncs, embedding, search. It prints counts and
# step names only — never a token, and never an event's text.
set -euo pipefail

steps=(
  "session: session status --check"
  "calendars: calendars list (counts)"
  "sync: sync"
  "sync-again: sync, and every calendar's round is changes, not full"
  "embed: sync --embed, skipped when no meaning model is downloaded"
  "search: --offline search <word> (counts)"
  "memo: memo search all <word> (counts), when memo is installed"
)

dry_run=false
args=()
for arg in "$@"; do
  if [[ $arg == --dry-run ]]; then dry_run=true; else args+=("$arg"); fi
done

root=$(cd "$(dirname "$0")/.." && pwd)
gcal() { node "$root/dist/bin/gcal.js" "$@"; }

if [[ ${#args[@]} -ne 2 ]]; then
  echo "usage: bin/gcal-live-check [--dry-run] <profile> <word to search for>" >&2
  if [[ -f $root/dist/bin/gcal.js ]]; then
    # Without a profile gcal refuses and names the profiles on this computer.
    gcal session status --json 2>&1 >/dev/null | node -e '
      let text = ""
      process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
        try { console.error(JSON.parse(text.trim().split("\n").at(-1)).error.message) } catch { console.error(text.trim()) }
      })' || true
  fi
  exit 2
fi
profile=${args[0]}
word=${args[1]}

if $dry_run; then
  for step in "${steps[@]}"; do echo "$step"; done
  exit 0
fi

(cd "$root" && pnpm --silent build)

# Reads a gcal JSON answer on stdin and prints what the expression makes of it; `a` is the answer.
summary() {
  node -e '
    let text = ""
    process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
      const a = JSON.parse(text)
      const out = new Function("a", `return (${process.argv[1]})`)(a)
      if (out === false) process.exit(1)
      if (out !== true) console.log(out)
    })' "$1"
}

answer=""
failed=""
# Runs one step; the error's code and gcal's own message are safe to show (gcal never repeats Google's text).
run() {
  local name=$1
  shift
  local err
  err=$(mktemp)
  if answer=$("$@" 2>"$err"); then
    rm -f "$err"
    return 0
  fi
  failed=$(node -e '
    const fs = require("node:fs")
    const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n")
    try { const { error } = JSON.parse(lines.at(-1)); console.log(`${error.code}: ${error.message}`) }
    catch { console.log("no JSON error") }' "$err")
  rm -f "$err"
  return 1
}
stop() {
  echo "FAILED at step $1: $2" >&2
  exit 1
}

run session gcal "$profile" session status --check --json || stop session "$failed"
echo "session: $(summary '`verified ${a.item.verified}`' <<<"$answer")"

run calendars gcal "$profile" calendars list --json || stop calendars "$failed"
echo "calendars: $(summary '`${a.items.length} listed, ${a.items.filter((c) => c.synced).length} synced`' <<<"$answer")"

rounds='`${a.item.synced.length} calendars, rounds ${[...new Set(a.item.synced.map((c) => c.round))].join("+") || "none"}, ` +
  `${a.item.synced.reduce((n, c) => n + c.saved, 0)} saved, ${a.item.synced.reduce((n, c) => n + c.occurrences, 0)} slots`'
run sync gcal "$profile" sync --json || stop sync "$failed"
echo "sync: $(summary "$rounds" <<<"$answer")"

run sync-again gcal "$profile" sync --json || stop sync-again "$failed"
echo "sync-again: $(summary "$rounds" <<<"$answer")"
summary 'a.item.synced.every((c) => c.round === "changes")' <<<"$answer" ||
  stop sync-again "a calendar listed its whole window again instead of only the changes"

if run embed gcal "$profile" sync --embed --json; then
  echo "embed: done"
elif [[ $failed == not_found:* ]]; then
  echo "embed: skipped, no meaning model is downloaded"
else
  stop embed "$failed"
fi

run search gcal "$profile" --offline search "$word" --json || stop search "$failed"
echo "search: $(summary '`${(a.item.hits ?? a.items ?? []).length} events found`' <<<"$answer")"

if command -v memo >/dev/null; then
  run memo memo search all "$word" --json || stop memo "$failed"
  echo "memo: $(summary '`${(a.items ?? a.item?.hits ?? a.item?.items ?? []).length} results`' <<<"$answer")"
else
  echo "memo: skipped, memo is not installed"
fi
echo "all steps passed"
